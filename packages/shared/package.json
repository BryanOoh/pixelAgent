{
  "name": "@pixelagent/shared",
  "version": "0.1.2",
  "description": "Shared types and DOM utilities for PixelAgent",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BryanOoh/pixelAgent.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/BryanOoh/pixelAgent#readme",
  "bugs": {
    "url": "https://github.com/BryanOoh/pixelAgent/issues"
  },
  "keywords": ["pixelagent", "dom", "design-tools", "react"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
