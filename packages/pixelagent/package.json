{
  "name": "pixelagent",
  "version": "0.1.11",
  "description": "Live DOM layer for vibe coders — annotate and edit running React apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BryanOoh/pixelAgent.git",
    "directory": "packages/pixelagent"
  },
  "homepage": "https://github.com/BryanOoh/pixelAgent#readme",
  "bugs": {
    "url": "https://github.com/BryanOoh/pixelAgent/issues"
  },
  "keywords": [
    "pixelagent",
    "react",
    "design-tools",
    "annotation",
    "devtools",
    "shadow-dom"
  ],
  "type": "module",
  "bin": {
    "pixelagent": "./bin/pixelagent.js"
  },
  "main": "./dist/pixelagent.js",
  "module": "./dist/pixelagent.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pixelagent.js"
    },
    "./style.css": "./dist/pixelagent.css"
  },
  "files": ["dist", "bin"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@pixelagent/cli": "0.1.11",
    "@pixelagent/shared": "0.1.11"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
